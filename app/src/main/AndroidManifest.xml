<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ir.example.transportationreport">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DateSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AddServiceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".ui.ServiceDetailsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:launchMode="singleTop"/>
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ReportsActivity"
            android:exported="false" />

        <!-- AndroidManifest.xml -->
        <activity
            android:name=".ui.ReportCollectionActivity"
            android:exported="false"
            android:parentActivityName=".ui.ReportsActivity"/>

        <activity
            android:name=".ui.DriverPerformanceActivity"
            android:exported="false"
            android:parentActivityName=".ui.ReportsActivity"/>


    </application>

</manifest>